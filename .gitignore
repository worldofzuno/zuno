node_modules
.next
out
__pycache__/
# Every env file except the committed example. The Stripe secret key lives
# in one of these; .env*.local alone left a plain .env committable.
.env
.env.*
!.env.example
.DS_Store
*.tsbuildinfo
next-env.d.ts

# impeccable writes its per-repo hook state here
.impeccable/

# Scratch comparison builds. site/ is the published folder — anything left
# here is served from the live domain, so these must never be committed.
site/_cmp.html

# Generated label textures for the 3D viewer. The generator is the source;
# the build inlines them into viewer/castano-3d.html.
viewer/assets/

# Rendered output. tools/render-bag.py regenerates it; the HDRI it needs is
# committed under render/env/.
render/*.png

# Playwright. test-results/ holds traces and screenshots from a failed run;
# playwright-report/ is the HTML viewer for them. Both are output.
test-results/
playwright-report/
