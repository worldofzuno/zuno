# Environment for the Stripe checkout function. Copy to .env for local work,
# and set the same keys in Netlify under Site configuration -> Environment
# variables. .env itself is gitignored; this example is not, so nothing
# secret belongs below.

# The secret key. Server-side only — it never reaches the browser, and it is
# never committed. Test keys start sk_test_, live keys sk_live_.
# Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=

# Price IDs. Not secret: a price id identifies a product, it cannot authorise
# anything. The values below are the SANDBOX prices, created 2026-09-30 in
# acct_1TwH5CEKR7ZXDl4J. Live mode has its own ids — swap both when going
# live, or the function will charge nothing and fail.
#
#   castano-200g  CHF 14.90  prod_VM6kkghrlO7v5l  tax_behavior inclusive
#   castano-500g  CHF 29.90  prod_VM6kCsI6RO31bJ  tax_behavior inclusive
STRIPE_PRICE_CASTANO_200G=price_1ULOWiEKR7ZXDl4JZtXvmS0s
STRIPE_PRICE_CASTANO_500G=price_1ULOWlEKR7ZXDl4JGCAQeSiU

# The public discount is not configured here. Stripe owns it: coupon
# "zuno-15-coffee" (15% off, duration once, restricted to the two coffee
# products) with promotion code ZUNO15. The restriction is not decoration:
# without it the code also discounts a gift card, which sells stored value
# below its face. A coupon's applies_to can only be set when it is created.
# The function
# only sets allow_promotion_codes; it never computes a discount.

# --- Family & Friends --------------------------------------------------

# The special prices, as Prices rather than as a discount. The two sizes are
# reduced by different amounts (14.90 -> 11.00 is -26.17%, 29.90 -> 20.00 is
# -33.11%) and a Checkout Session takes at most one coupon, so no single
# coupon could produce both. These are SANDBOX ids, created 2026-10-03 on the
# same products as the regular prices, CHF, tax_behavior inclusive:
#
#   castano-200g  CHF 11.00  price_1UMVQyEKR7ZXDl4JxEyxMDZh
#   castano-500g  CHF 20.00  price_1UMVR6EKR7ZXDl4JMowa63sy
#
# Leave both unset and any code is refused rather than silently charging the
# regular price.
STRIPE_PRICE_FNF_CASTANO_200G=price_1UMVQyEKR7ZXDl4JxEyxMDZh
STRIPE_PRICE_FNF_CASTANO_500G=price_1UMVR6EKR7ZXDl4JMowa63sy

# The codes themselves, as JSON. This is the one place they exist — nothing is
# hard-coded in the client, and nothing about them lives in Stripe.
#
#   [{"code":"FAMILY26","expires":"2026-12-31","maxRedemptions":100}]
#
# "code" is required: letters, digits and hyphens, 3 to 64 characters, matched
# case-insensitively and with whitespace ignored — but NOT with hyphens
# ignored. A hyphen here is a character of the code you chose, so FAMILY-26
# and FAMILY26 are two different codes and can both be configured. (A gift
# card is the other way round: its hyphens are formatting we insert into a
# code generated without them, so ZG-ABCD-… and ZGABCD… are the same card.) "expires" (YYYY-MM-DD, valid to
# the end of that day) and "maxRedemptions" are optional. Several entries are
# allowed, so a code can be rotated by adding the new one before removing the
# old. To switch a code off, delete its entry; to switch the feature off
# entirely, leave this empty. Malformed JSON disables every code rather than
# enabling them, so a typo closes the door.
#
# Treat this as a secret: it is the code itself. Netlify reads environment
# variables at cold start, so a change needs a redeploy to take effect.
FNF_CODES=

# --- Gift cards --------------------------------------------------------

# Three fixed amounts and the product behind them. SANDBOX ids, created
# 2026-10-03, CHF with tax_behavior inclusive, on a product marked
# shippable: false — a gift card goes to an inbox, not in a parcel.
#
#   gift-25   CHF  25.00  price_1UMWLTEKR7ZXDl4Js4UCn7bL
#   gift-50   CHF  50.00  price_1UMWLVEKR7ZXDl4JNY2aiIji
#   gift-100  CHF 100.00  price_1UMWLeEKR7ZXDl4J0z07jWhY
STRIPE_PRICE_GIFT_25=price_1UMWLTEKR7ZXDl4Js4UCn7bL
STRIPE_PRICE_GIFT_50=price_1UMWLVEKR7ZXDl4JNY2aiIji
STRIPE_PRICE_GIFT_100=price_1UMWLeEKR7ZXDl4J0z07jWhY

# The product a chosen amount is billed against. There is no Price for the
# "Other" option: the amount is sent inline, clamped server-side to CHF 15 –
# 200, and the card is issued from what Stripe says was PAID. That is the one
# amount a client may send, and it is safe because the customer pays exactly
# the figure they typed and receives exactly that much credit.
STRIPE_PRODUCT_GIFT=prod_VNGsiJYIan0sUZ

# Balances live in Netlify Blobs under the store "zuno", keys gift/<CODE>.
# Nothing to configure: Blobs is part of the site. Off Netlify the same code
# keeps state in memory and says so in the log, which is fine for a local
# run and useless for anything real.

# --- Back office -------------------------------------------------------

# The one key to /admin/: gift card balances, issuing a card by hand,
# voiding one, finding and deleting accounts, and the backup. There is no
# account system behind it and no roles — it is you or nobody.
#
# At least 24 characters, or the function refuses to use it rather than
# quietly accepting a weak one. Generate rather than invent:
#
#     openssl rand -base64 32
#
# Treat it like the Stripe secret key. Anyone holding it can read every
# balance and hand out money.
ADMIN_TOKEN=

# --- Mail --------------------------------------------------------------

# Who the mail comes from, and where shop-side notices go. MAIL_FROM must be
# on a domain the provider has verified, or the message is refused.
#
# A bare address is enough: MAIL_FROM_NAME (default "ZUNO") is put in front
# of it, so the reader sees a name rather than a mailbox. A full
# "Name <addr>" pair is taken as written. The address is the part that
# changes; the name is the brand and belongs in one place.
#
# NOT noreply@. A customer who replies to an order confirmation is asking a
# question, and Microsoft's filters count noreply@ on a young domain against
# it. Whatever stands here must be a mailbox somebody reads.
MAIL_FROM=info@worldofzuno.com
MAIL_FROM_NAME=
# Where a reply actually lands, when that cannot be the sending address.
# Defaults to MAIL_FROM, which is right as soon as that address can receive.
#
# It is set today because worldofzuno.com has no MX record: info@ is what
# the Impressum, the packaging and every mail footer show, and it is what
# the mails are sent from — but nothing can be delivered to it. A Reply-To
# somewhere that works means the Reply button reaches a person, which is
# the path almost everybody takes. Someone who copies the address out of
# the footer still gets a bounce; the fix for that is an MX record, not
# this.
MAIL_REPLY_TO=
MAIL_TO=

# Where the shop lives, for the links and the logo inside a mail. Netlify
# sets URL to the project's primary address by itself, so this stays empty
# unless something needs overriding: a local run that wants to point at
# production, or a deploy preview that should link to itself.
SITE_URL=

# The provider. Leave MAIL_PROVIDER unset and whichever key is present is
# used; set it to "resend" or "postmark" to pin one. With no key at all the
# message is written to the function log and nothing is sent — which the
# order confirmation tolerates and the account password reset does not.
MAIL_PROVIDER=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# --- stripe-webhook.mjs ------------------------------------------------

# The webhook signing secret, starting whsec_. Without it every delivery is
# refused, which is the point: it is what separates a real notification from
# someone posting invented orders at the endpoint. Each endpoint has its own
# secret, and the test and live endpoints differ.
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=

# Optional. Where a finished order is POSTed as JSON — an email relay, an
# automation tool, a spreadsheet endpoint. Leave it unset and orders are
# written to the Netlify function log instead, which is durable and readable
# but is not an inbox.
ORDER_NOTIFY_URL=
